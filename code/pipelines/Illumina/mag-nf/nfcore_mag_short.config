// nf-core/mag v3.1.0 config for Illumina SHORT-READ metagenomics (viral focus).
// Disables binning / bin-QC / GTDB-Tk (not needed for viral detection) and tunes
// resources + apptainer mounts for this cluster.

params {
    skip_binning = true   // no MAG binning
    skip_binqc   = true   // no BUSCO / CheckM
    skip_gtdbtk  = true   // no GTDB-Tk (avoids busco_db file(null) error)
}

// Apptainer / Singularity: bypass /lscratch, bind /scratch and /home
apptainer {
    autoMounts = false
    runOptions = '--no-mount /lscratch --bind /scratch:/scratch --bind /home:/home'
}
singularity {
    autoMounts = false
    runOptions = '--no-mount /lscratch --bind /scratch:/scratch --bind /home:/home'
}

process {
    containerOptions = '--no-mount /lscratch'

    // Kraken2 now uses the DB that mag prepares from --kraken2_db (the symlink
    // tarball built in the submit script). No ext.args override needed — mag
    // passes the prepared 'database/' to kraken2 itself. Give it real resources.
    withName: 'NFCORE_MAG:MAG:KRAKEN2' {
        time = '48.h'; cpus = 16; memory = '256.GB'
    }

    // PhiX removal (Bowtie2): more time/resources for large read sets
    withName: 'NFCORE_MAG:MAG:BOWTIE2_PHIX_REMOVAL_ALIGN' {
        time = '96.h'; cpus = 32; memory = '256.GB'
        ext.args = '--very-fast -D 10 -R 2 -N 0 -L 20'
    }
    withName: 'NFCORE_MAG:MAG:BOWTIE2_PHIX_REMOVAL_BUILD' {
        time = '24.h'; cpus = 16; memory = '128.GB'
    }

    // SPAdes (metaSPAdes) assembly tuning
    withName: 'NFCORE_MAG:MAG:SPADES' {
        time = '360.h'; cpus = 16; memory = '480.GB'
        ext.args = '--memory 400'
    }
    // MEGAHIT assembly tuning
    withName: 'NFCORE_MAG:MAG:MEGAHIT' {
        time = '360.h'; cpus = 16; memory = '480.GB'
    }
}

report { overwrite = true }
