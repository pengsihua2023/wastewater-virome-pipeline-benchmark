// Hybrid Metagenome Assembly and Kraken2 Workflow Configuration
//
// Supports both short-read and long-read metagenome analysis
//
// Usage:
// nextflow run metagenome_hybrid_workflow.nf -c metagenome_hybrid_workflow.config

process {
    executor = 'slurm'
    queue = 'bahl_p'
    // Load the conda module in SLURM jobs so that the conda command is available on all nodes
    // Use --wrap or pass the conda path through an environment variable
    // Note: when creating a conda environment, Nextflow does not execute beforeScript
    // so conda availability must be ensured in clusterOptions, or set condaPath
    clusterOptions = '--ntasks=1 --export=ALL'
    
    errorStrategy = 'retry'
    maxRetries = 2
    
    // Load the conda module before the process runs (for conda environment management)
    // Note: when creating a conda environment, Nextflow does not execute beforeScript
    // so CONDA_BASE and PATH must be set in the main script and passed with --export=ALL
    beforeScript = '''
        # If CONDA_BASE has already been passed through the environment, use it
        if [ -n "$CONDA_BASE" ] && [ -f "$CONDA_BASE/bin/conda" ]; then
            export PATH="$CONDA_BASE/bin:$PATH"
            if [ -f "$CONDA_BASE/etc/profile.d/conda.sh" ]; then
                source "$CONDA_BASE/etc/profile.d/conda.sh"
            fi
        else
            # Otherwise try loading the Miniforge3 module
            if command -v module &> /dev/null; then
                module load Miniforge3/24.11.3-0 2>/dev/null || true
            fi
            
            # Initialize conda
            if ! command -v conda &> /dev/null; then
                # Try to find it in common paths
                CONDA_PATHS="/opt/software/Miniconda3 /usr/local/miniconda3 /opt/conda /usr/local/conda"
                for base_path in $CONDA_PATHS; do
                    if [ -d "$base_path" ] && [ -f "$base_path/bin/conda" ]; then
                        export CONDA_BASE="$base_path"
                        export PATH="$base_path/bin:$PATH"
                        break
                    fi
                done
            fi
            
            # Make sure conda is in PATH
            if command -v conda &> /dev/null; then
                export CONDA_BASE=$(conda info --base 2>/dev/null || echo "$CONDA_BASE")
                if [ -n "$CONDA_BASE" ] && [ -f "$CONDA_BASE/etc/profile.d/conda.sh" ]; then
                    source "$CONDA_BASE/etc/profile.d/conda.sh"
                fi
            fi
        fi
    '''
    
    // Default resource allocation
    cpus = 16
    memory = '128 GB'
    time = '48h'
    
    // ========================================
    // SHORT-READ PROCESSES
    // ========================================
    
    withName: 'FASTP' {
        cpus = 16
        memory = '64 GB'
        time = '48h'
        label = 'process_medium'
    }
    
    withName: 'MEGAHIT_ASSEMBLY' {
        cpus = 16  // reduce the number of CPU threads to lower the memory requirement (32 threads need more memory)
        memory = '512 GB'  // increase memory to process very large datasets (4 billion+ reads need at least 400 GB of memory)
        time = '72h'  // increase the time limit to fit large datasets
        label = 'process_high'
    }
    
    withName: 'SPADES_ASSEMBLY' {
        cpus = 32
        memory = '768 GB'  // increase memory to process very large datasets (the earlier 512 GB was not enough; the run failed once about 115 GB was in use)
        time = '128h'  // increase the time limit to fit very large datasets
        label = 'process_high'
    }
    
    withName: 'BOWTIE2_BUILD_MEGAHIT' {
        cpus = 16
        memory = '64 GB'
        time = '48h'
        label = 'process_medium'
    }
    
    withName: 'BOWTIE2_BUILD_SPADES' {
        cpus = 16
        memory = '64 GB'
        time = '48h'
        label = 'process_medium'
    }
    
    withName: 'BOWTIE2_ALIGN_MEGAHIT' {
        cpus = 32
        memory = '128 GB'
        time = '48h'
        label = 'process_high'
    }
    
    withName: 'BOWTIE2_ALIGN_SPADES' {
        cpus = 16
        memory = '128 GB'
        time = '48h'
        label = 'process_high'
    }
    
    withName: 'CALCULATE_ABUNDANCE_MEGAHIT' {
        cpus = 16
        memory = '64 GB'
        time = '48h'
        label = 'process_low'
        // Add a conda-specific beforeScript
        beforeScript = '''
            module load Miniforge3/24.11.3-0 2>/dev/null || true
            export CONDA_BASE=$(conda info --base 2>/dev/null || echo "")
            if [ -n "$CONDA_BASE" ] && [ -f "$CONDA_BASE/etc/profile.d/conda.sh" ]; then
                source "$CONDA_BASE/etc/profile.d/conda.sh"
            fi
            export PATH="$CONDA_BASE/bin:$PATH"
        '''
    }
    
    withName: 'CALCULATE_ABUNDANCE_SPADES' {
        cpus = 16
        memory = '64 GB'
        time = '48h'
        label = 'process_low'
        // Add a conda-specific beforeScript
        beforeScript = '''
            module load Miniforge3/24.11.3-0 2>/dev/null || true
            export CONDA_BASE=$(conda info --base 2>/dev/null || echo "")
            if [ -n "$CONDA_BASE" ] && [ -f "$CONDA_BASE/etc/profile.d/conda.sh" ]; then
                source "$CONDA_BASE/etc/profile.d/conda.sh"
            fi
            export PATH="$CONDA_BASE/bin:$PATH"
        '''
    }
    
    withName: 'KRAKEN2_CLASSIFICATION_MEGAHIT' {
        cpus = 16
        memory = '128 GB'
        time = '48h'
        label = 'process_medium'
    }
    
    withName: 'KRAKEN2_CLASSIFICATION_SPADES' {
        cpus = 16
        memory = '128 GB'
        time = '72h'
        label = 'process_medium'
    }
    
    withName: 'MERGE_KRAKEN2_REPORTS_SHORT' {
        cpus = 16
        memory = '64 GB'
        time = '72h'
        label = 'process_low'
        // Add a conda-specific beforeScript
        beforeScript = '''
            # If CONDA_BASE has already been passed through the environment, use it
            if [ -n "$CONDA_BASE" ] && [ -f "$CONDA_BASE/bin/conda" ]; then
                export PATH="$CONDA_BASE/bin:$PATH"
                if [ -f "$CONDA_BASE/etc/profile.d/conda.sh" ]; then
                    source "$CONDA_BASE/etc/profile.d/conda.sh"
                fi
            else
                # Otherwise try loading the Miniforge3 module
                if command -v module &> /dev/null; then
                    module load Miniforge3/24.11.3-0 2>/dev/null || true
                fi
                # Initialize conda
                if command -v conda &> /dev/null; then
                    export CONDA_BASE=$(conda info --base 2>/dev/null)
                    if [ -n "$CONDA_BASE" ] && [ -f "$CONDA_BASE/etc/profile.d/conda.sh" ]; then
                        source "$CONDA_BASE/etc/profile.d/conda.sh"
                    fi
                fi
            fi
        '''
    }
    
    // ========================================
    // LONG-READ PROCESSES
    // ========================================
    
    withName: 'FLYE_ASSEMBLY' {
        cpus = 32
        memory = '256 GB'
        time = '96h'
        label = 'process_high'
    }
    
    withName: 'VIRALFLYE_IDENTIFY' {
        cpus = 16
        memory = '64 GB'
        time = '72h'
        label = 'process_high'
    }
    
    withName: 'MINIMAP2_ALIGN_FLYE' {
        cpus = 16
        memory = '64 GB'
        time = '72h'
        label = 'process_high'
    }
    
    withName: 'MINIMAP2_ALIGN_VIRALFLYE_LINEAR' {
        cpus = 16
        memory = '64 GB'
        time = '24h'
        label = 'process_medium'
    }
    
    withName: 'MINIMAP2_ALIGN_VIRALFLYE_CIRCULAR' {
        cpus = 16
        memory = '64 GB'
        time = '96h'
        label = 'process_medium'
    }
    
    withName: 'CALCULATE_ABUNDANCE_FLYE' {
        cpus = 16
        memory = '64 GB'
        time = '96h'
        label = 'process_low'
        // Add a conda-specific beforeScript
        beforeScript = '''
            module load Miniforge3/24.11.3-0 2>/dev/null || true
            export CONDA_BASE=$(conda info --base 2>/dev/null || echo "")
            if [ -n "$CONDA_BASE" ] && [ -f "$CONDA_BASE/etc/profile.d/conda.sh" ]; then
                source "$CONDA_BASE/etc/profile.d/conda.sh"
            fi
            export PATH="$CONDA_BASE/bin:$PATH"
        '''
    }
    
    withName: 'CALCULATE_ABUNDANCE_VIRALFLYE_LINEAR' {
        cpus = 16
        memory = '64 GB'
        time = '72h'
        label = 'process_low'
        // Add a conda-specific beforeScript
        beforeScript = '''
            module load Miniforge3/24.11.3-0 2>/dev/null || true
            export CONDA_BASE=$(conda info --base 2>/dev/null || echo "")
            if [ -n "$CONDA_BASE" ] && [ -f "$CONDA_BASE/etc/profile.d/conda.sh" ]; then
                source "$CONDA_BASE/etc/profile.d/conda.sh"
            fi
            export PATH="$CONDA_BASE/bin:$PATH"
        '''
    }
    
    withName: 'CALCULATE_ABUNDANCE_VIRALFLYE_CIRCULAR' {
        cpus = 16
        memory = '64 GB'
        time = '72h'
        label = 'process_low'
        // Add a conda-specific beforeScript
        beforeScript = '''
            module load Miniforge3/24.11.3-0 2>/dev/null || true
            export CONDA_BASE=$(conda info --base 2>/dev/null || echo "")
            if [ -n "$CONDA_BASE" ] && [ -f "$CONDA_BASE/etc/profile.d/conda.sh" ]; then
                source "$CONDA_BASE/etc/profile.d/conda.sh"
            fi
            export PATH="$CONDA_BASE/bin:$PATH"
        '''
    }
    
    withName: 'KRAKEN2_CLASSIFICATION_FLYE' {
        cpus = 16
        memory = '128 GB'
        time = '96h'
        label = 'process_medium'
    }
    
    withName: 'KRAKEN2_CLASSIFICATION_VIRALFLYE_LINEAR' {
        cpus = 16
        memory = '128 GB'
        time = '96h'
        label = 'process_medium'
    }
    
    withName: 'KRAKEN2_CLASSIFICATION_VIRALFLYE_CIRCULAR' {
        cpus = 16
        memory = '128 GB'
        time = '96h'
        label = 'process_medium'
    }
}

params {
    // Resource limits
    max_cpus = 32
    max_memory = '512.GB'
    max_time = '72.h'
    
    // Short-read parameters
    skip_fastp = false
    fastp_qualified_quality = 20
    fastp_unqualified_percent = 40
    fastp_min_length = 50
    
    megahit_memory = 0.5  // reduce the memory fraction to avoid out-of-memory errors, using 50% of the available memory (512GB * 0.5 = 256GB, enough for this dataset)
    megahit_min_contig_len = 1000
    spades_meta = true
    
    // Long-read parameters
    flye_genome_size = '5m'
    flye_min_overlap = 3000
    long_read_type = 'nanopore'  // Options: 'nanopore', 'pacbio', 'pacbio-hifi'
    run_viralflye = true  // Run viralFlye to identify viral contigs from metaFlye
    viralflye_hmm = '/scratch/$USER/Meta-genome-data-analysis/Apptainer/databases/Pfam/Pfam-A.hmm'
    viralflye_min_length = 2000  // Minimum viral contig length (2kb to capture small DNA viruses like Circoviridae)
    viralflye_completeness = 0.5  // Completeness cutoff (0.5 for complete viral genomes)
    viralflye_threads = 10  // Threads for viralFlye
    
    // Kraken2 parameters
    kraken2_confidence = 0.05
    kraken2_min_base_quality = 0
    kraken2_min_hit_groups = 1
    
    // Report parameters
    skip_merge_reports = false
}

// Apptainer/Singularity configuration
apptainer {
    enabled = true
    autoMounts = true
    cacheDir = '/scratch/$USER/Meta-genome-data-analysis/Apptainer/singularity'
    runOptions = '--no-mount /lscratch'  // Disable /lscratch mount (not available on this cluster)
}

// Conda configuration
conda {
    enabled = true
    cacheDir = '/scratch/$USER/Meta-genome-data-analysis/conda_cache'
    // Note: when creating a conda environment, Nextflow does not execute beforeScript
    // Try to get the conda path from the environment variable and, if available, set condaPath
    // This requires the NXF_CONDA_PATH environment variable to be set in the main script and passed with --export=ALL
    def condaPathEnv = System.getenv('NXF_CONDA_PATH')
    if (condaPathEnv) {
        condaPath = condaPathEnv
    }
    // If the environment variable is not set, Nextflow will look in PATH for conda
}

// Environment variables
env {
    SINGULARITY_BIND = "/scratch/$USER/Meta-genome-data-analysis/Apptainer/databases:/databases"
    // Note: these environment variables may not be available when the conda environment is created
    // The conda module must be loaded in beforeScript
}

