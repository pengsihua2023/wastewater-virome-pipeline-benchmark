// PacBio HiFi Metagenome Assembly and Kraken2 Workflow Configuration
//
// Optimized for PacBio HiFi (CCS) long reads
// Key differences from Nanopore:
//   - Flye uses --pacbio-hifi (high-accuracy mode, no error correction pass)
//   - Minimap2 uses asm20 preset (tuned for HiFi error rate ~0.1%)
//   - HiFi reads are pre-polished, so no Medaka polishing step needed
//
// Usage:
// nextflow run metagenome_hybrid_workflow.nf -c metagenome_pacbio_workflow.config

process {
    executor = 'slurm'
    queue = 'bahl_p'
    clusterOptions = '--ntasks=1 --export=ALL'

    errorStrategy = 'retry'
    maxRetries = 2

    beforeScript = '''
        if [ -n "$CONDA_BASE" ] && [ -f "$CONDA_BASE/bin/conda" ]; then
            export PATH="$CONDA_BASE/bin:$PATH"
            if [ -f "$CONDA_BASE/etc/profile.d/conda.sh" ]; then
                source "$CONDA_BASE/etc/profile.d/conda.sh"
            fi
        else
            if command -v module &> /dev/null; then
                module load Miniforge3/24.11.3-0 2>/dev/null || true
            fi
            if ! command -v conda &> /dev/null; then
                CONDA_PATHS="/opt/software/Miniconda3 /usr/local/miniconda3 /opt/conda /usr/local/conda"
                for base_path in $CONDA_PATHS; do
                    if [ -d "$base_path" ] && [ -f "$base_path/bin/conda" ]; then
                        export CONDA_BASE="$base_path"
                        export PATH="$base_path/bin:$PATH"
                        break
                    fi
                done
            fi
            if command -v conda &> /dev/null; then
                export CONDA_BASE=$(conda info --base 2>/dev/null || echo "$CONDA_BASE")
                if [ -n "$CONDA_BASE" ] && [ -f "$CONDA_BASE/etc/profile.d/conda.sh" ]; then
                    source "$CONDA_BASE/etc/profile.d/conda.sh"
                fi
            fi
        fi
    '''

    cpus   = 16
    memory = '128 GB'
    time   = '48h'

    // ========================================
    // LONG-READ PROCESSES (PacBio HiFi)
    // ========================================

    withName: 'FLYE_ASSEMBLY' {
        // HiFi assembly is faster than Nanopore due to no error-correction pass,
        // but still needs substantial memory for large metagenomes.
        cpus   = 32
        memory = '256 GB'
        time   = '72h'
        label  = 'process_high'
    }

    withName: 'VIRALFLYE_IDENTIFY' {
        cpus   = 16
        memory = '64 GB'
        time   = '72h'
        label  = 'process_high'
    }

    withName: 'MINIMAP2_ALIGN_FLYE' {
        cpus   = 16
        memory = '64 GB'
        time   = '48h'
        label  = 'process_high'
        beforeScript = '''
            module load Miniforge3/24.11.3-0 2>/dev/null || true
            export CONDA_BASE=$(conda info --base 2>/dev/null || echo "")
            if [ -n "$CONDA_BASE" ] && [ -f "$CONDA_BASE/etc/profile.d/conda.sh" ]; then
                source "$CONDA_BASE/etc/profile.d/conda.sh"
            fi
            export PATH="$CONDA_BASE/bin:$PATH"
        '''
    }

    withName: 'MINIMAP2_ALIGN_VIRALFLYE_LINEAR' {
        cpus   = 16
        memory = '64 GB'
        time   = '24h'
        label  = 'process_medium'
        beforeScript = '''
            module load Miniforge3/24.11.3-0 2>/dev/null || true
            export CONDA_BASE=$(conda info --base 2>/dev/null || echo "")
            if [ -n "$CONDA_BASE" ] && [ -f "$CONDA_BASE/etc/profile.d/conda.sh" ]; then
                source "$CONDA_BASE/etc/profile.d/conda.sh"
            fi
            export PATH="$CONDA_BASE/bin:$PATH"
        '''
    }

    withName: 'MINIMAP2_ALIGN_VIRALFLYE_CIRCULAR' {
        cpus   = 16
        memory = '64 GB'
        time   = '48h'
        label  = 'process_medium'
        beforeScript = '''
            module load Miniforge3/24.11.3-0 2>/dev/null || true
            export CONDA_BASE=$(conda info --base 2>/dev/null || echo "")
            if [ -n "$CONDA_BASE" ] && [ -f "$CONDA_BASE/etc/profile.d/conda.sh" ]; then
                source "$CONDA_BASE/etc/profile.d/conda.sh"
            fi
            export PATH="$CONDA_BASE/bin:$PATH"
        '''
    }

    withName: 'CALCULATE_ABUNDANCE_FLYE' {
        cpus   = 16
        memory = '64 GB'
        time   = '72h'
        label  = 'process_low'
        beforeScript = '''
            module load Miniforge3/24.11.3-0 2>/dev/null || true
            export CONDA_BASE=$(conda info --base 2>/dev/null || echo "")
            if [ -n "$CONDA_BASE" ] && [ -f "$CONDA_BASE/etc/profile.d/conda.sh" ]; then
                source "$CONDA_BASE/etc/profile.d/conda.sh"
            fi
            export PATH="$CONDA_BASE/bin:$PATH"
        '''
    }

    withName: 'CALCULATE_ABUNDANCE_VIRALFLYE_LINEAR' {
        cpus   = 16
        memory = '64 GB'
        time   = '48h'
        label  = 'process_low'
        beforeScript = '''
            module load Miniforge3/24.11.3-0 2>/dev/null || true
            export CONDA_BASE=$(conda info --base 2>/dev/null || echo "")
            if [ -n "$CONDA_BASE" ] && [ -f "$CONDA_BASE/etc/profile.d/conda.sh" ]; then
                source "$CONDA_BASE/etc/profile.d/conda.sh"
            fi
            export PATH="$CONDA_BASE/bin:$PATH"
        '''
    }

    withName: 'CALCULATE_ABUNDANCE_VIRALFLYE_CIRCULAR' {
        cpus   = 16
        memory = '64 GB'
        time   = '48h'
        label  = 'process_low'
        beforeScript = '''
            module load Miniforge3/24.11.3-0 2>/dev/null || true
            export CONDA_BASE=$(conda info --base 2>/dev/null || echo "")
            if [ -n "$CONDA_BASE" ] && [ -f "$CONDA_BASE/etc/profile.d/conda.sh" ]; then
                source "$CONDA_BASE/etc/profile.d/conda.sh"
            fi
            export PATH="$CONDA_BASE/bin:$PATH"
        '''
    }

    withName: 'KRAKEN2_CLASSIFICATION_FLYE' {
        cpus   = 16
        memory = '128 GB'
        time   = '72h'
        label  = 'process_medium'
    }

    withName: 'KRAKEN2_CLASSIFICATION_VIRALFLYE_LINEAR' {
        cpus   = 16
        memory = '128 GB'
        time   = '72h'
        label  = 'process_medium'
    }

    withName: 'KRAKEN2_CLASSIFICATION_VIRALFLYE_CIRCULAR' {
        cpus   = 16
        memory = '128 GB'
        time   = '72h'
        label  = 'process_medium'
    }
}

params {
    // Resource limits
    max_cpus   = 32
    max_memory = '512.GB'
    max_time   = '96.h'

    // ----------------------------------------
    // PacBio HiFi long-read settings
    // ----------------------------------------
    // Use 'pacbio-hifi' for CCS/HiFi reads (Q20+, ~0.1% error rate).
    // Use 'pacbio' for CLR reads (lower accuracy, higher error rate).
    long_read_type = 'pacbio-hifi'

    // Flye metagenome assembly:
    //   Leave genome_size empty — metaFlye estimates it automatically.
    //   Leave min_overlap empty — Flye auto-selects based on read N50.
    flye_genome_size = ''
    flye_min_overlap = ''

    // viralFlye viral contig identification
    run_viralflye        = true
    viralflye_hmm        = '/scratch/$USER/Meta-genome-data-analysis/Apptainer/databases/Pfam/Pfam-A.hmm'
    viralflye_min_length = 2000   // 2 kb captures small DNA viruses (e.g. Circoviridae)
    viralflye_completeness = 0.5
    viralflye_threads    = 10

    // Kraken2
    kraken2_confidence     = 0.05
    kraken2_min_base_quality = 0
    kraken2_min_hit_groups = 1

    skip_merge_reports = false
}

// Apptainer/Singularity configuration
apptainer {
    enabled    = true
    autoMounts = true
    cacheDir   = '/scratch/$USER/Meta-genome-data-analysis/Apptainer/singularity'
    runOptions = '--no-mount /lscratch'
}

// Conda configuration
conda {
    enabled   = true
    cacheDir  = '/scratch/$USER/Meta-genome-data-analysis/conda_cache'
    condaPath = '/apps/eb/Miniforge3/24.11.3-0/bin/conda'
}

env {
    SINGULARITY_BIND = "/scratch/$USER/Meta-genome-data-analysis/Apptainer/databases:/databases"
}
