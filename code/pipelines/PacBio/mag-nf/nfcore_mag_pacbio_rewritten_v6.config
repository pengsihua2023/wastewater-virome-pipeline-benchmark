// Nextflow infrastructure/resource config for nf-core/mag PacBio HiFi long-read-only runs.
// Pipeline parameters are intentionally kept out of this config and are supplied
// via -params-file to preserve boolean/number types with Nextflow 26.x.

apptainer {
    enabled = true
    autoMounts = false
    runOptions = '--no-mount /lscratch --bind /scratch:/scratch --bind /home:/home'
}

// Nextflow cannot enable both apptainer and singularity.
singularity {
    enabled = false
}

process {
    withName: /.*FLYE.*/ {
        cpus   = 16
        memory = '240.GB'
        time   = '120.h'
        // mag already adds "--pacbio-hifi <reads>" from long_reads_platform, so
        // ext.args must NOT repeat it (a duplicate --pacbio-hifi makes Flye abort
        // with "expected at least one argument"). Only add metagenome mode here.
        ext.args = '--meta'
    }

    withName: /.*METAMDBG.*/ {
        cpus   = 16
        memory = '240.GB'
        time   = '120.h'
        // Safety net: if metaMDBG is re-enabled (RUN_METAMDBG=true) and crashes
        // on a small input, don't kill the run — let Flye's assembly proceed.
        errorStrategy = 'ignore'
    }

    withName: /.*FASTQC.*/ {
        cpus   = 2
        memory = '8.GB'
        time   = '24.h'
    }

    withName: /.*MULTIQC.*/ {
        cpus   = 2
        memory = '8.GB'
        time   = '24.h'
    }
}

report { overwrite = true }
timeline { overwrite = true }
trace { overwrite = true }
